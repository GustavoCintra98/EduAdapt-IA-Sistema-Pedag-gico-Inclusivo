# ==============================================================================
# EduAdapt IA - Configurações de Ambiente
# ==============================================================================

# Porta da aplicação web / API
PORT=3000

# Chave de API Google Gemini (para recursos de IA pedagógica DUA)
GEMINI_API_KEY=

# ==============================================================================
# Conexão Segura com MySQL / MySQL Workbench
# ==============================================================================
# Host do banco de dados (ex: localhost, 127.0.0.1, ou endpoint de nuvem AWS RDS / GCP Cloud SQL)
DB_HOST=localhost

# Porta padrão do MySQL
DB_PORT=3306

# Nome do banco de dados relacional
DB_NAME=eduadapt_db

# Usuário de banco com menor privilégio (GRANT SELECT, INSERT, UPDATE, DELETE)
DB_USER=eduadapt_user

# Senha segura do banco de dados
DB_PASSWORD=

# Segurança SSL/TLS (recomendado 'true' ou 'require' para conexões remotas em nuvem)
DB_SSL=false

# Validação do certificado SSL da autoridade certificadora (true para produção)
DB_SSL_REJECT_UNAUTHORIZED=true

# Caminho opcional para arquivo de certificado CA (.pem ou .crt) para conexões SSL personalizadas
DB_SSL_CA_PATH=

# Limite do pool de conexões simultâneas para prevenção de exaustão de recursos
DB_CONNECTION_LIMIT=10
